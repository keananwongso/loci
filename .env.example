# Copy this file to .env.local and fill in ONE provider. .env.local is git-ignored.
# Never commit a real key. Loci picks the provider from whichever key is set.

# Anthropic (Claude). Default model: claude-opus-5-5
ANTHROPIC_API_KEY=

# Or any OpenAI-compatible API (set LOCI_MODEL too unless noted):
# OPENROUTER_API_KEY=          # e.g. LOCI_MODEL=google/gemini-2.5-flash
# DEEPSEEK_API_KEY=            # LOCI_MODEL defaults to deepseek-flash
# GEMINI_API_KEY=              # Google AI Studio; has a free tier
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Local models with Ollama (no key; the model must support tool calling):
# LOCI_PROVIDER=ollama
# LOCI_MODEL=qwen3

# Any other OpenAI-compatible endpoint:
# LOCI_PROVIDER=custom
# LOCI_BASE_URL=http://localhost:1234/v1
# LOCI_API_KEY=

# Optional
# LOCI_PROVIDER=               # anthropic | openrouter | deepseek | gemini | openai | groq | ollama | custom | mock
# LOCI_MODEL=                  # overrides the provider's default model
# LOCI_VISION=auto             # auto | on | off  (auto: send images, fall back to text-only if refused)
# LOCI_EFFORT=medium           # Anthropic only: low | medium | high

# Voice mode (optional). Without a Fish key, Loci uses the browser's built-in voice.
# FISH_API_KEY=                # https://fish.audio, about $15 per million characters
# FISH_VOICE_ID=               # optional: a voice model id from fish.audio
# LOCI_TTS_MODEL=s2-pro
