# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit a real key.

# Required for the Anthropic (Claude) tutor provider.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides
# LOCI_PROVIDER=anthropic        # anthropic | mock (mock replays a scripted lesson, for UI development without a key)
# LOCI_MODEL=claude-opus-5-5
# LOCI_EFFORT=medium             # low | medium | high
