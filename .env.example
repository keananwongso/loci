# Copy this file to .env.local and fill in ONE provider. .env.local is git-ignored.
# Never commit a real key. Loci picks the provider from whichever key is set.

# Anthropic (Claude). Default model: claude-opus-5-5
ANTHROPIC_API_KEY=

# Or any OpenAI-compatible API (set LOCI_MODEL too unless noted):
# OPENROUTER_API_KEY=          # e.g. LOCI_MODEL=google/gemini-2.5-flash
# DEEPSEEK_API_KEY=            # LOCI_MODEL defaults to deepseek-flash
# GEMINI_API_KEY=              # Google AI Studio; has a free tier
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Local models with Ollama (no key; the model must support tool calling):
# LOCI_PROVIDER=ollama
# LOCI_MODEL=qwen3

# Any other OpenAI-compatible endpoint:
# LOCI_PROVIDER=custom
# LOCI_BASE_URL=http://localhost:1234/v1
# LOCI_API_KEY=

# Optional
# LOCI_PROVIDER=               # anthropic | openrouter | deepseek | gemini | openai | groq | ollama | custom | mock
# LOCI_MODEL=                  # overrides the provider's default model
# LOCI_VISION=auto             # auto | on | off  (auto: send images, fall back to text-only if refused)
# LOCI_EFFORT=medium           # Anthropic only: low | medium | high
# LOCI_THINKING=off            # DeepSeek only: on lets the model reason first (much slower turns)

# Voice mode (optional). Without a Fish key, Loci uses the browser's built-in voice.
# FISH_API_KEY=                # https://fish.audio, about $15 per million characters
# FISH_VOICE_ID=               # optional: a voice model id from fish.audio
# LOCI_TTS_MODEL=s2-pro
# Leave delivery controls unset to use Fish Audio defaults (speed 1, temperature 0.7, latency normal).
# LOCI_TTS_SPEED=             # optional override, 0.5 to 2
# LOCI_TTS_TEMPERATURE=       # optional override, 0 to 1
# LOCI_TTS_LATENCY=           # optional override: normal | balanced

# Hosting a public demo (leave unset when running locally)
# LOCI_DEMO_LIMITS=on          # defaults on on Vercel; set on for other public hosts
# LOCI_LIMIT_PER_DEVICE=5      # per browser per day (signed cookie)
# LOCI_LIMIT_PER_IP=20         # per network per day (looser, for shared campus wifi)
# LOCI_LIMIT_GLOBAL=300        # total per day: this caps your spend
# Fish Audio use under the same limits, so voice can't be used to spend your credits either.
# LOCI_LIMIT_SPEECH_CHARS_PER_DEVICE=8000    # characters of speech per browser per day
# LOCI_LIMIT_SPEECH_CHARS_PER_IP=32000
# LOCI_LIMIT_SPEECH_CHARS_GLOBAL=400000      # about $6 a day at Fish's prices
# LOCI_LIMIT_TRANSCRIBE_PER_DEVICE=15        # spoken questions transcribed per browser per day
# LOCI_LIMIT_TRANSCRIBE_PER_IP=60
# LOCI_LIMIT_TRANSCRIBE_GLOBAL=1500
# LOCI_COOKIE_SECRET=          # any long random string
# Upstash through Vercel Marketplace supplies KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# UPSTASH_REDIS_REST_URL=      # counters for serverless hosts (Upstash free tier)
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY=   # tldraw needs a license key on a public domain (not a secret)
